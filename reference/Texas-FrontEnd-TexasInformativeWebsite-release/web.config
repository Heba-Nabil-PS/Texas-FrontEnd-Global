<configuration>
  <system.webServer>

    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode"/>
    </handlers>

    <rewrite>
      <rules>

        <!--
          Keep external redirects ahead of internal rewrites. IIS evaluates
          rules in order, and a rewrite changes the URL seen by later rules.
        -->
        <rule name="RepairLegacyMalformedHttpsRedirect" stopProcessing="true">
          <match url="^https:/+c/?$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Found" />
        </rule>

        <!-- Preserve the original path with the rule capture, not REQUEST_URI. -->
        <rule name="SSL" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action
            type="Redirect"
            url="https://{HTTP_HOST}/{R:1}"
            redirectType="Permanent" />
        </rule>

        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}"/>
        </rule>

        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True"/>
          </conditions>
          <action type="Rewrite" url="server.js"/>
        </rule>

      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules"/>
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

    <iisnode node_env="production" enableXFF="true"/>

  </system.webServer>
</configuration>